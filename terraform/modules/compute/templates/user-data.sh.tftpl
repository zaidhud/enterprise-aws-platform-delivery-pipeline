#!/bin/bash
set -euxo pipefail

dnf update -y

systemctl enable amazon-ssm-agent
systemctl restart amazon-ssm-agent

mkdir -p /opt/eapdp
mkdir -p /opt/eapdp/releases
mkdir -p /opt/eapdp/config

echo "EC2 bootstrap completed successfully" > /var/log/eapdp-bootstrap.log
echo "Environment: ${environment}" >> /var/log/eapdp-bootstrap.log
echo "Application deployment is managed by Ansible" >> /var/log/eapdp-bootstrap.log