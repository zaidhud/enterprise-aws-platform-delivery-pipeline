# Terraform working directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Terraform variable files
*.tfvars
*.tfvars.json

# Allow example variable files
!*.tfvars.example

# Terraform plans
*.tfplan
tfplan

# Terraform crash logs
crash.log
crash.*.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ansible retry files
*.retry

# SSH and private key files
*.pem
*.key
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# Environment and secret files
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Windows and macOS files
Thumbs.db
.DS_Store

# Logs and temporary files
*.log
tmp/
temp/

.venv/
